{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./shared/config/production.env)",
      "Read(./**/*.db)",
      "Read(./**/*.sqlite*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git add .)",
      "Bash(git add -A*)",
      "Bash(git add --all*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(*ship.cmd*)",
      "Bash(npm install*)"
    ]
  }
}
